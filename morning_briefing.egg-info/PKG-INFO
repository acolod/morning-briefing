        "version": "production v1",
        "traits": "dense / polished / adaptive / image-light",
        "tags": ["standalone html", "subtle motion", "dated footer", "mobile-openable"],
    },
    "visual_note": {
        "title": "Article-style visuals are the better fit.",
        "body": "Visual text here",
