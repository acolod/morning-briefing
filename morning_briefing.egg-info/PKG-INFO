        "Link 1 text",
        "Link 2 text",
        "Link 3 text",
    ],
    "visual_rules": [
        {"eyebrow": "Tone", "title": "...", "body": "..."},
        {"eyebrow": "Scale", "title": "...", "body": "..."},
    ],
    "metadata": {
        "date": "June 3, 2026",
        "published": "6:42 AM PT",
        "source_window": "Prior 18 hours",
        "issue_id": "#001",
    },
    "toprail": {
        "path": "/briefs/2026-06-03",
        "version": "v1 production",
        "mode": "builder",
